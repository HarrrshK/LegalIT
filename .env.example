# Configure these in the API process environment. Do not commit real secrets.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-unique-password-at-least-16-characters
ADMIN_NAME=Platform Administrator
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
API_PORT=3001
# New FastAPI service. Use an absolute DATABASE_URL for production.
ENVIRONMENT=development
DATA_DIR=./data
UPLOAD_DIR=./data/uploads
DATABASE_URL=sqlite:///./data/legalit.db
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
SESSION_TTL_SECONDS=43200
GROQ_TIMEOUT_SECONDS=30
MAX_AI_INPUT_CHARS=6000
MAX_AI_OUTPUT_TOKENS=1200
RETRIEVAL_RESULT_COUNT=8
MAX_UPLOAD_BYTES=15728640
LOGIN_RATE_LIMIT=10
AI_RATE_LIMIT=30
RATE_LIMIT_WINDOW_SECONDS=60
# Comma-separated browser origins in production, for example https://legalit.example.com
APP_ORIGIN=
